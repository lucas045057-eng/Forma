# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略
LUX3D_API_KEY=
LUX3D_BASE=https://api.aholo3d.cn
# mock: LUX3D_BASE=http://127.0.0.1:4010, LUX3D_API_KEY=mock-only
# ASSETS_DIR 可设绝对路径，用于隔离 mock 测试数据；默认仓库 .data/assets
# 下载全程总时限（毫秒，含 DNS/重定向/响应体）
ASSET_DOWNLOAD_TIMEOUT_MS=120000
# PORT=3001
# 编码 Agent（M2）：OpenAI 兼容接口；每个请求须带 x-opencode-session 头（同一任务用同一个值）
CODING_AGENT_BASE_URL=https://opencode.ai/zen/go/v1
CODING_AGENT_API_KEY=
CODING_AGENT_MODEL=deepseek-v4.1-flash
# 语音转写（阿里云百炼，OpenAI 兼容端点）；SPEECH_BASE_URL 无默认值，缺失即视为未配置
SPEECH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
SPEECH_MODEL=qwen3-asr-flash
