{
  "name": "spatial-ai-workbench",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @spatial/studio --filter @spatial/product-page --filter @spatial/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @spatial/vite-plugin-source-tag --filter @spatial/server --filter @spatial/bridge --filter @spatial/shared --filter @spatial/scene-renderer --filter @spatial/studio test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:m0a": "playwright test -c playwright.m0a.config.ts",
    "test:e2e:m1a": "playwright test -c playwright.m1a.config.ts",
    "test:e2e:m1b": "playwright test -c playwright.m1b.config.ts",
    "test:e2e:m2a": "playwright test -c playwright.m2a.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
